# Enable Banking application (Control Panel -> your app). The .pem is named after the app ID.
EB_APP_ID=00000000-0000-0000-0000-000000000000
EB_KEY_PATH=secrets/00000000-0000-0000-0000-000000000000.pem
# Must exactly match one of the redirect URLs registered for the app.
EB_REDIRECT_URL=https://localhost:8501/callback

# Local storage
FIN_DATA_DIR=data
